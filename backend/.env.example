PORT=5001
DATABASE_URL=postgresql://user:password@host/dbname
API_URL=http://localhost:5001

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk
